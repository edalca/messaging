   "label": "AI Provider",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "configuration",
   "fieldtype": "Link",
   "options": "AI Configuration",
   "label": "AI Configuration",
   "read_only": 1
  },
  {
   "fieldname": "requested_model",
   "fieldtype": "Data",
   "label": "Requested Model",
   "read_only": 1,
   "in_list_view": 1
  },
