   "fieldname": "actual_model",
   "fieldtype": "Data",
   "label": "Actual Model",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "operation",
   "fieldtype": "Data",
   "label": "Operation",
   "read_only": 1,
   "in_list_view": 1
  },
