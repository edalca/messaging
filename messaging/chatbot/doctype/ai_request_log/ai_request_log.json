   "options": "Prepared\nAttempted\nResponded",
   "read_only": 1,
   "permlevel": 1,
   "description": "Prepared: no transport call. Attempted: transport invoked; transmission is uncertain. Responded: an HTTP response was received.",
   "hidden": 1
