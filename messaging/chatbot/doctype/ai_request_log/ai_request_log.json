   "fieldname": "diagnostics_html",
   "fieldtype": "HTML",
   "permlevel": 1
  },
  {
   "fieldname": "column_break_general",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "column_break_usage",
   "fieldtype": "Column Break"
  }
 ],
 "field_order": [
  "general_tab",
  "provider",
  "configuration",
  "operation",
  "requested_model",
  "actual_model",
  "status",
  "column_break_general",
  "turn",
  "evaluation_id",
  "request_key",
  "request_sequence",
  "evaluated_at",
  "latency_ms",
  "usage_tab",
  "input_tokens_reported",
  "input_tokens",
  "output_tokens_reported",
  "output_tokens",
  "column_break_usage",
  "total_tokens_reported",
  "total_tokens",
  "diagnostics_tab",
  "diagnostics_html",
  "request_section",
  "transmission_state",
  "request_text",
  "result_summary",
  "error_code",
  "error_log"
 ],
 "permissions": [
