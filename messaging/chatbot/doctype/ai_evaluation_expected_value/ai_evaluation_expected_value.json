{
 "doctype": "DocType",
 "name": "AI Evaluation Expected Value",
 "module": "Chatbot",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "ref",
   "fieldtype": "Data",
   "label": "Ref",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "parameter_type",
   "fieldtype": "Select",
   "label": "Parameter Type",
   "options": "String\nInt\nDate\nName\nExpression",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "value_text",
   "fieldtype": "Small Text",
   "label": "Value Text",
   "depends_on": "eval:!['Int','Date'].includes(doc.parameter_type)",
   "in_list_view": 1
  },
  {
   "fieldname": "value_int",
   "fieldtype": "Int",
   "label": "Value Int",
   "depends_on": "eval:doc.parameter_type==='Int'",
   "in_list_view": 1
  },
  {
   "fieldname": "value_date",
   "fieldtype": "Date",
   "label": "Value Date",
   "depends_on": "eval:doc.parameter_type==='Date'",
   "in_list_view": 1
  }
 ],
 "field_order": [
  "ref",
  "parameter_type",
  "value_text",
  "value_int",
  "value_date"
 ],
 "istable": 1,
 "permissions": [],
 "track_changes": 0,
 "allow_rename": 0
}
