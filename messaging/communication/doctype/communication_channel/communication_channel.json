{
 "doctype": "DocType",
 "name": "Communication Channel",
 "module": "Communication",
 "engine": "InnoDB",
 "field_order": [
  "general_tab",
  "provider",
  "channel_name",
  "column_break_channel",
  "status",
  "single_provider_key",
  "parameters_section",
  "parameter_controls",
  "parameters",
  "meta_webhook_section",
  "meta_webhook_token",
  "meta_webhook_details",
  "meta_webhook_evidence",
  "section_quotas",
  "quotas_enabled",
  "daily_quota_limit",
  "monthly_quota_limit",
  "quota_timezone",
  "column_break_quotas",
  "quota_consumption_basis",
  "composite_response_single_unit",
  "quota_reservation_ttl_seconds",
  "reconcile_quota_on_acceptance",
  "section_courtesy",
  "quota_courtesy_enabled",
  "column_break_courtesy",
  "quota_courtesy_max_per_cycle",
  "public_information_tab",
  "public_organization_section",
  "public_organization",
  "public_service",
  "public_email",
  "public_contact_column",
  "public_website",
  "public_contact",
  "public_description",
  "public_documents_section",
  "public_documents_controls",
  "public_privacy_draft",
  "public_terms_draft",
  "public_deletion_draft",
  "public_document_snapshots"
 ],
 "fields": [
  {
   "fieldname": "general_tab",
   "fieldtype": "Tab Break",
   "label": "General"
  },
  {
   "fieldname": "provider",
   "fieldtype": "Link",
   "label": "Provider",
   "options": "Communication Provider",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "channel_name",
   "fieldtype": "Data",
   "label": "Channel Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Disabled\nEnabled",
   "default": "Disabled",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_channel",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "parameters_section",
   "fieldtype": "Section Break",
   "label": "Provider Parameters"
  },
  {
   "fieldname": "single_provider_key",
   "fieldtype": "Data",
   "label": "Single Provider Key",
   "unique": 1,
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "parameter_controls",
   "fieldtype": "HTML",
   "label": "Parameters"
  },
  {
   "fieldname": "parameters",
   "fieldtype": "Table",
   "label": "Parameters",
   "options": "Communication Provider Value",
   "hidden": 1
  },
  {
   "fieldname": "meta_webhook_section",
   "fieldtype": "Section Break",
   "label": "Meta Webhook",
   "depends_on": "eval:doc.provider === 'WHATSAPP' && !doc.__islocal"
  },
  {
   "fieldname": "meta_webhook_token",
   "fieldtype": "HTML"
  },
  {
   "fieldname": "meta_webhook_details",
   "fieldtype": "HTML"
  },
  {
   "fieldname": "meta_webhook_evidence",
   "fieldtype": "JSON",
   "hidden": 1,
   "read_only": 1,
   "permlevel": 1
  },
  {
   "fieldname": "section_quotas",
   "fieldtype": "Section Break",
   "label": "Automatic Reply Quotas"
  },
  {
   "default": "0",
   "fieldname": "quotas_enabled",
   "fieldtype": "Check",
   "label": "Enable Automatic Reply Quotas"
  },
  {
   "description": "Daily limit based on a rolling 24-hour window.",
   "fieldname": "daily_quota_limit",
   "fieldtype": "Int",
   "label": "Daily Quota Limit (24h Rolling Window)"
  },
  {
   "description": "Monthly limit per calendar month in the configured timezone.",
   "fieldname": "monthly_quota_limit",
   "fieldtype": "Int",
   "label": "Monthly Quota Limit (Calendar Month)"
  },
  {
   "fieldname": "quota_timezone",
   "fieldtype": "Autocomplete",
   "label": "Applicable Quota Timezone",
   "mandatory_depends_on": "eval:doc.quotas_enabled"
  },
  {
   "fieldname": "column_break_quotas",
   "fieldtype": "Column Break"
  },
  {
   "description": "Consumption is based on automated outgoing messages accepted by the provider, not delivery or read receipts.",
   "fieldname": "quota_consumption_basis",
   "fieldtype": "Select",
   "label": "Quota Consumption Trigger",
   "options": "\nProvider Accepted",
   "read_only": 1
  },
  {
   "default": "0",
   "description": "A composite response in a single message counts as one unit unless exempt.",
   "fieldname": "composite_response_single_unit",
   "fieldtype": "Check",
   "label": "Composite Response in Single Message Counts as 1 Unit",
   "read_only": 1
  },
  {
   "description": "Transactional reservation duration in seconds before reconciling provider acceptance.",
   "fieldname": "quota_reservation_ttl_seconds",
   "fieldtype": "Int",
   "label": "Quota Reservation TTL (Seconds)"
  },
  {
   "default": "0",
   "fieldname": "reconcile_quota_on_acceptance",
   "fieldtype": "Check",
   "label": "Reconcile Quota Reservation on Provider Acceptance",
   "read_only": 1
  },
  {
   "fieldname": "section_courtesy",
   "fieldtype": "Section Break",
   "label": "Quota Courtesy"
  },
  {
   "default": "0",
   "description": "Allow an exempt courtesy message when the contact reaches the quota limit (independent of the greeting).",
   "fieldname": "quota_courtesy_enabled",
   "fieldtype": "Check",
   "label": "Enable Courtesy Message"
  },
  {
   "fieldname": "column_break_courtesy",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.quota_courtesy_enabled",
   "fieldname": "quota_courtesy_max_per_cycle",
   "fieldtype": "Int",
   "label": "Max Courtesy Notices Per Quota Cycle",
   "mandatory_depends_on": "eval:doc.quota_courtesy_enabled"
  },
  {
   "fieldname": "public_information_tab",
   "fieldtype": "Tab Break",
   "label": "Public Information"
  },
  {
   "fieldname": "public_organization_section",
   "fieldtype": "Section Break",
   "label": "Public Organization Details"
  },
  {
   "fieldname": "public_organization",
   "fieldtype": "Data",
   "label": "Legal Entity or Organization"
  },
  {
   "fieldname": "public_service",
   "fieldtype": "Data",
   "label": "Public Service Name"
  },
  {
   "fieldname": "public_email",
   "fieldtype": "Data",
   "label": "Public Contact Email",
   "options": "Email"
  },
  {
   "fieldname": "public_contact_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "public_website",
   "fieldtype": "Data",
   "label": "Official Website"
  },
  {
   "fieldname": "public_contact",
   "fieldtype": "Small Text",
   "label": "Additional Public Contact Details"
  },
  {
   "fieldname": "public_description",
   "fieldtype": "Small Text",
   "label": "Public Service Description"
  },
  {
   "fieldname": "public_documents_section",
   "fieldtype": "Section Break",
   "label": "Public Documents"
  },
  {
   "fieldname": "public_documents_controls",
   "fieldtype": "HTML"
  },
  {
   "fieldname": "public_privacy_draft",
   "fieldtype": "Long Text",
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "public_terms_draft",
   "fieldtype": "Long Text",
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "public_deletion_draft",
   "fieldtype": "Long Text",
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "public_document_snapshots",
   "fieldtype": "Long Text",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "track_changes": 0,
 "allow_rename": 0,
 "naming_rule": "By script",
 "title_field": "channel_name",
 "search_fields": "channel_name,provider"
}
